{
  "name": "newapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.vue --fix --cache --cache-location .eslintcache",
    "format": "npm run prettier:write && npm run lint:fix",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@fontsource/noto-sans-arabic": "^5.2.7",
    "@fontsource/vazirmatn": "^5.2.6",
    "@iconify/vue": "^5.0.0",
    "axios": "^1.11.0",
    "dompurify": "^3.2.6",
    "laravel-echo": "^2.2.0",
    "luxon": "^3.7.2",
    "photoswipe": "^5.4.4",
    "pinia": "^2.3.1",
    "pusher-js": "^8.4.0",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
    "video.js": "^8.23.4",
    "vue": "^3.5.18",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "wavesurfer.js": "^7.10.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.5"
  }
}
